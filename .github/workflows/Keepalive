name: Keepalive

on:
  schedule:
    # Runs monthly-ish. GitHub cron uses UTC.
    - cron: "0 15 1 * *"  # 9:00 AM CT (usually); adjust if you want
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  keepalive:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Bump keepalive timestamp
        run: |
          mkdir -p .github
          date -u +"%Y-%m-%dT%H:%M:%SZ" > .github/keepalive.txt

      - name: Commit and push (only if changed)
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .github/keepalive.txt
          git diff --cached --quiet && exit 0
          git commit -m "chore: keep scheduled workflows active"
          git push
